        <script><![CDATA[(function executeRule(current, previous) {
    if (current.room_number && current.check_in && current.check_out) {
        var room = new GlideRecord('x_1939650_smart_0_u_rooms');
        if (room.get(current.room_number)) {
            var checkIn = new GlideDateTime(current.check_in.toString());
            var checkOut = new GlideDateTime(current.check_out.toString());
            var ms = checkOut.getNumericValue() - checkIn.getNumericValue();
            var nights = Math.ceil(ms / 86400000);
            if (nights < 1) nights = 1;
            current.total_bookings = parseFloat(room.price_per_night) * nights;
        }
    }
})(current, previous);]]></script>
