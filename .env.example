# ServiceNow Enterprise Credentials
VITE_SN_INSTANCE=https://your-instance.service-now.com
VITE_SN_USERNAME=your_username
VITE_SN_PASSWORD=your_password

# Supabase Auth & Cloud Database
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Admin Demo Credentials
VITE_ADMIN_EMAIL=admin@example.com
VITE_ADMIN_PASSWORD=your_admin_password

# Staff Demo Credentials
VITE_STAFF_EMAIL=staff@example.com
VITE_STAFF_PASSWORD=your_staff_password

# EmailJS Configuration (Optional)
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_BOOKING=your_booking_template_id
VITE_EMAILJS_TEMPLATE_SERVICE=your_service_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# OpenAI / AI Concierge API
VITE_OPENAI_API_KEY=your_openai_api_key_here
